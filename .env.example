DATABASE_URL=
ADMIN_INITIAL_OWNER_NAME=
ADMIN_INITIAL_OWNER_EMAIL=
ADMIN_INITIAL_OWNER_PASSWORD=
SITE_NAME=Biosfera Rádio TV Web
RADIO_STREAM_URL=https://s1.dvr.ovh:6696/stream
LIVE_CAMERA_EMBED_URL=https://playerv.tvr.ovh/video-premium/video36282/true/false/
SITE_URL=http://localhost:3000
# Somente leitura de imagens legadas em desenvolvimento (e storage de vídeos).
# Novas imagens editoriais exigem R2, inclusive em desenvolvimento.
UPLOAD_DIR=
# Apenas para testes, PostgreSQL LOCAL com permissão CREATEDB
TEST_DATABASE_URL=
PORTAL_TIMEZONE=America/Sao_Paulo

# Storage oficial de imagens editoriais. Configure também no ambiente de produção.
# Nunca use NEXT_PUBLIC_ para credenciais.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Integrações Google (opcional; o painel admin pode sobrescrever estes valores)
GA4_ENABLED=false
GA4_MEASUREMENT_ID=
ADSENSE_ENABLED=false
ADSENSE_CLIENT_ID=
